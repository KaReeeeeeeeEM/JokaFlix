# TMDB
# Either key works while the migration is still compatible with the old Vite env name.
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key
# VITE_TMDB_API_KEY=your_tmdb_api_key

# Auth and database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3004
NEXT_PUBLIC_APP_URL=http://localhost:3004
BETTER_AUTH_RP_ID=localhost

# Email verification through Nodemailer Gmail SMTP.
# These match the TSCS backend email configuration.
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM_NAME=JokaFlix

# Downloads
# Use server-only values when possible. The download API route redirects to these sources.
#
# Template placeholders supported:
# {mediaType} -> movie or tv
# {type}      -> movie or tv
# {id}        -> TMDB id
# {tmdbId}    -> TMDB id
# {quality}   -> 1080p, 720p, or 480p
# {season}    -> season number for series downloads

# Separate movie and series sources are preferred.
MOVIE_DOWNLOAD_BASE_URL=https://your-download-source.example/movies/{id}/{quality}.mp4
SERIES_DOWNLOAD_BASE_URL=https://your-download-source.example/series/{id}/season-{season}/{quality}.mp4

# If your provider uses the same base for both movies and series, use this instead.
# The app will call:
#   {base}/movie/{id}?quality=720p
#   {base}/tv/{id}?quality=720p&season=1
# NEXT_PUBLIC_DOWNLOAD_BASE_URL=https://your-download-source.example/download
